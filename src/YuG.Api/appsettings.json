{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=yug.db"
  },
  "Jwt": {
    "SecretKey": "",
    "Issuer": "YuG.Api",
    "Audience": "YuG.Client",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001"
    ]
  },
  "Cache": {
    "FilePath": "cache.db"
  },
  "AI": {
    "SystemPrompt": "你是 YuG 智能助手，一个高效、专业的中文 AI 助手。",
    "TitleGenerationPrompt": "根据以下对话内容生成一个简短的会话标题，不超过12个字。只返回标题文本，不要有多余内容。"
  },
  "RefitConfig": {
    "AIGateway": {
      "BaseUrl": "http://localhost:5100"
    }
  }
}
